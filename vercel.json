{
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(ncm|cnae)/[0-9]{7,8}", "dest": "/index.html" },
    { "src": "/.*", "dest": "/index.html" }
  ],
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    }
  ]
}
